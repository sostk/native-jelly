+    EARC_WHEN_ANY_LEASE_PORT, /* eARC on, any lease held, x[reg] == value */
+    EARC_WHEN_ANY_LEASE,      /* any lease held */
 };
 enum earc_action {
     EARC_SET_REG = 1,  /* x[reg] = value; counts overrides */
     EARC_CLEAR_U64,    /* *(u64 *)(x[reg] + a) = 0 if set; counts mix_clears */
