/* Copy this file to config.local.h and fill in your Jellyfin server host.
 * config.local.h is gitignored. Only PMS_HOST/PMS_PORT are compiled into the app —
 * the binary carries NO credentials: access comes from in-app Jellyfin sign-in,
 * or from the /tmp/nativejelly-token dev trigger for automated runs.
 *
 * PMS_TOKEN is read by tests/run.py on the BUILD HOST only (it injects the token
 * onto the TV at test time via /tmp/nativejelly-token); it is never compiled into the app. */
#define PMS_HOST  "YOUR_JELLYFIN_HOST"
#define PMS_PORT  8096
#define PMS_TOKEN "YOUR_JELLYFIN_TOKEN"
